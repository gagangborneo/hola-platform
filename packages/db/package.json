{
  "name": "@hola/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "generate": "drizzle-kit generate",
    "migrate": "node src/migrate.ts",
    "studio": "drizzle-kit studio",
    "seed": "node --env-file-if-exists=../../.env src/seed.ts"
  },
  "dependencies": {
    "@hola/shared": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
