NODE_ENV=development
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
API_BASE_URL_INTERNAL=http://localhost:4000
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:9000/hola-media
# Wajib sama dengan mode Midtrans di API. Membentuk CSP saat build.
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
# DSN boleh kosong untuk mematikan pelaporan error di local.
NEXT_PUBLIC_SENTRY_DSN=
# Ketiganya hanya dipakai saat build untuk upload source map; jangan commit nilai sebenarnya.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_GA_ID=
