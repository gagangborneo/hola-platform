{
  "name": "@hola/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "build": "esbuild src/index.ts src/worker.ts src/bullboard.ts --bundle --packages=external --platform=node --format=esm --target=node24 --outdir=dist --sourcemap",
    "worker": "node --watch src/worker.ts",
    "bullboard": "node --watch src/bullboard.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "@aws-sdk/s3-request-presigner": "^3.1096.0",
    "@bull-board/api": "^8.3.0",
    "@bull-board/hono": "^8.3.0",
    "@hola/db": "workspace:*",
    "@hola/shared": "workspace:*",
    "@hono/node-server": "^2.0.12",
    "@hono/zod-validator": "^0.9.0",
    "@opentelemetry/api": "^1.9.1",
    "@sentry/node": "^10.68.0",
    "argon2": "^0.45.1",
    "bullmq": "^5.81.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "ioredis": "^5.11.1",
    "jose": "^6.2.4",
    "nodemailer": "^9.0.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "esbuild": "^0.27.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
